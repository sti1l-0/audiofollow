// AudioFollow 设置窗口 —— 控件全部手绘,不依赖 std-widgets 的默认外观。
//
// 为什么不用 std-widgets 的 Button/CheckBox/ComboBox：它们按"桌面原生"风格渲染,
// 在本主题下灰暗、密度失衡(下拉框和背景糊在一起、勾选框文字发虚)。
// 这里自绘 Switch / AppButton / Dropdown,hover/按下/禁用的状态反馈都可控。
//
// 日志区刻意保持深色终端风:它是排查工具,不是内容展示,和浅色卡片拉开层次。

import { ListView } from "std-widgets.slint";

// ---------- 界面用数据结构 ----------

export struct RuleRow {
    monitor: string,
    endpoint: string,
    enabled: bool,
}

export struct LogRow {
    time: string,
    msg: string,
}

// ---------- 主题 ----------

export global Theme {
    out property <color> bg: #edf0f5;
    out property <color> card: #ffffff;
    out property <color> border: #e2e7ef;
    out property <color> hover-row: #f4f7fb;
    out property <color> text: #1b2434;
    out property <color> text-2: #5b6a80;
    out property <color> text-3: #98a4b6;
    out property <color> accent: #3565e3;
    out property <color> accent-hover: #2a55c6;
    out property <color> accent-soft: #e9effd;
    out property <color> danger: #d03050;
    out property <color> danger-soft: #fbeaee;
    out property <color> ok: #18a058;
    out property <color> log-bg: #111a2b;
    out property <color> log-time: #55708f;
    out property <color> log-text: #c6d6ea;
}

// ---------- 手绘控件 ----------

// 滑动开关。
component Switch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 36px;
    height: 20px;
    border-radius: self.height / 2;
    background: self.checked ? Theme.accent : #c6d0df;
    animate background { duration: 150ms; }

    Rectangle {
        // 滑块
        x: parent.checked ? parent.width - self.width - 2px : 2px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: self.width / 2;
        background: white;
        animate x { duration: 150ms; easing: ease-out; }
    }

    // 键盘可达：Tab 聚焦后 Enter/空格等效点击。FocusScope 不拦截鼠标事件，
    // 放在 TouchArea 下面一层，纯键盘用途。
    FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                parent.checked = !parent.checked;
                parent.toggled(parent.checked);
                return accept;
            }
            reject
        }
    }

    TouchArea {
        clicked => {
            parent.checked = !parent.checked;
            parent.toggled(parent.checked);
        }
    }
}

// 按钮。primary = 实心主色,danger = 实心红,两者都不设 = 白底描边。
component AppButton inherits Rectangle {
    in property <string> text: "按钮";
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 32px;
    min-width: 92px;
    border-radius: 8px;
    background: !self.enabled ? #dee3ec
        : ta.has-hover ? (danger ? #bb2847 : primary ? Theme.accent-hover : #eef2f8)
        : (danger ? Theme.danger : primary ? Theme.accent : Theme.card);
    // 焦点环：键盘用户必须能看到焦点在哪（FocusScope 在下面的 fs）
    border-width: fs.has-focus ? 2px : (primary || danger || !self.enabled ? 0 : 1px);
    border-color: fs.has-focus ? Theme.accent : Theme.border;
    animate background { duration: 110ms; }

    // 键盘可达：Tab 聚焦后 Enter/空格触发 clicked。不拦截鼠标事件。
    fs := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text;
        font-size: 13px;
        font-weight: root.primary || root.danger ? 600 : 500;
        color: !root.enabled ? #9aa5b5
            : (root.primary || root.danger ? white : Theme.text);
    }
}

// 下拉框。显示当前选中项,点击弹出浮层列表。
// PopupWindow 而不是内嵌展开:内嵌会把下面的内容挤下去,顶层浮层才对。
component Dropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: -1;
    in property <string> placeholder: "请选择";
    callback select(int);

    height: 34px;
    min-width: 170px;
    border-radius: 8px;
    background: Theme.card;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent : ta.has-hover ? #c3cfe1 : Theme.border;
    animate border-color { duration: 110ms; }

    // 键盘可达：Tab 聚焦后 Enter/空格弹开列表，↑/↓ 直接换选中项（不必弹开），
    // Esc 关闭弹层。FocusScope 不拦截鼠标事件。
    fs := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                list-popup.show();
                return accept;
            }
            if (event.text == Key.Escape) {
                list-popup.close();
                return accept;
            }
            if (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                if (root.model.length > 0) {
                    if (root.current-index < 0) {
                        root.current-index = 0;
                    } else {
                        root.current-index = Math.max(0, Math.min(root.model.length - 1,
                            root.current-index + (event.text == Key.DownArrow ? 1 : -1)));
                    }
                    root.select(root.current-index);
                }
                return accept;
            }
            reject
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { list-popup.show(); }
    }

    // 绝对定位而不是 HorizontalLayout：布局对固定尺寸的 Path 的垂直落点
    // 不可控（实测箭头会飘到框顶，甚至整体不渲染），手工居中最稳。
    Text {
        // "▾" 在默认字体里没有字形（渲染成豆腐块），改用 Path 画三角
        x: 12px;
        width: parent.width - 12px - 26px;
        height: parent.height;
        text: root.current-index >= 0 && root.current-index < root.model.length
            ? root.model[root.current-index]
            : root.placeholder;
        font-size: 13px;
        color: root.current-index >= 0 ? Theme.text : Theme.text-3;
        overflow: elide;
        vertical-alignment: center;
    }
    Path {
        width: 9px;
        height: 6px;
        x: parent.width - 12px;
        y: (parent.height - self.height) / 2;
        viewbox-width: 9;
        viewbox-height: 6;
        commands: "M 0 0 L 9 0 L 4.5 6 Z";
        fill: Theme.text-3;
    }

    list-popup := PopupWindow {
        y: root.height + 6px;
        width: root.width;
        height: min(root.model.length * 30px + 12px, 236px);

        Rectangle {
            background: Theme.card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 6px;
                ListView {
                    for item[index] in root.model : Rectangle {
                        height: 30px;
                        border-radius: 6px;
                        background: index == root.current-index ? Theme.accent-soft
                            : opt.has-hover ? #f1f4f9 : transparent;
                        Text {
                            x: 10px;
                            width: parent.width - 18px;
                            text: item;
                            font-size: 13px;
                            color: index == root.current-index ? Theme.accent : Theme.text;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        opt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.current-index = index;
                                root.select(index);
                                list-popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------- 主窗口 ----------

export component AppWindow inherits Window {
    title: "音频跟随";
    // 应用图标唯一来源（gen_icon.py 生成）：窗口标题栏、任务栏、Alt+Tab 都用它。
    icon: @image-url("icon.png");
    // 尺寸必须用 preferred-：直接设 width/height 是"固定尺寸"（min==max），
    // slint-winit 会判定窗口不可缩放 —— 不给 WS_THICKFRAME、最大化按钮禁用、
    // 布局锁死在 880x640（resize 后内容不重排、拖边框被弹回）。
    // preferred- 才是"初始尺寸 + 可弹性伸缩"。
    preferred-width: 880px;
    preferred-height: 640px;
    min-width: 700px;
    min-height: 560px;
    background: Theme.bg;

    // ---- Rust 侧读写的数据 ----
    in-out property <[string]> monitor-lines: [];
    in-out property <[string]> endpoint-lines: [];
    in-out property <[RuleRow]> rules: [];
    in-out property <[LogRow]> log-entries: [];
    in-out property <int> monitor-index: -1;
    in-out property <int> endpoint-index: -1;
    in-out property <bool> auto-follow: true;
    in-out property <bool> event-driven: true;
    in-out property <bool> hook-live: false;
    in-out property <bool> startup: false;
    in-out property <string> headline: "正在初始化…";
    // 日志区展开状态。展开时占窗口一半高，收起时固定 170px。
    in-out property <bool> log-expanded: false;
    // 「添加绑定」附近的内联提示（失败原因就地显示，而不是只沉到下面日志区里）。
    // 空串 = 无提示。
    in-out property <string> add-hint: "";

    // ---- Rust 侧挂接的动作 ----
    callback add-rule();
    callback remove-rule(int);
    callback toggle-rule(int);
    callback auto-match();
    callback rescan();
    callback apply-now();
    callback toggle-auto-follow(bool);
    callback toggle-event-driven(bool);
    callback toggle-startup(bool);
    callback restore-all();

    VerticalLayout {
        padding: 20px;
        padding-top: 16px;
        spacing: 12px;

        // ================= 标题栏 =================
        // 不用 HorizontalLayout：同一行里"固定高度元素"(图标/开关)和 Text 的
        // 垂直落点由布局 stretch 规则决定，实测两者会错位(开关偏上、文字贴底)。
        // 全部绝对定位，落点完全可控。
        Rectangle {
            height: 38px;

            Image {
                // 应用图标（与窗口/任务栏/托盘同源）
                x: 0;
                y: 0;
                width: 38px;
                height: 38px;
                source: @image-url("icon.png");
            }

            VerticalLayout {
                x: 50px;
                y: 0;
                height: parent.height;
                // 右侧留出两组开关的位置（「开机启动」+「自动跟随」）
                width: parent.width - 50px - 240px;
                spacing: 2px;
                Text {
                    text: "音频跟随";
                    font-size: 19px;
                    font-weight: 800;
                    color: Theme.text;
                }
                Text {
                    text: root.headline;
                    font-size: 12px;
                    color: Theme.text-2;
                    overflow: elide;
                }
            }

            // 两个全局开关：右起「自动跟随」，它的左边是「开机启动」。
            // 每一组都是「文字在左、开关在右」，整组从窗口右边界往回推。
            //
            // 位置靠**引用相邻元素的 x** 推出来，不用布局 —— slint 里固定尺寸
            // 元素（Switch）在布局中的垂直落点不可控（实测差 15px），绝对定位最稳。
            //
            // ⚠️ 开关的宽度必须算在**自己那一组**里。第一版把「开机启动」的开关
            // 摆在自己文字的右边（`x: startup-label.x + startup-label.width + 8px`），
            // 结果它右半截压到了「自动跟随」四个字上：4 个 13px 汉字约 52px 宽，
            // 而两组之间只留了 24px。这类"漏算自己宽度"的错目视截图很容易放过，
            // 所以下面这四个 x 全部由**相邻元素的真实 x 反推**，不写字面量。
            auto-switch := Switch {
                checked <=> root.auto-follow;
                toggled(on) => { root.toggle-auto-follow(on); }
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
            }
            auto-label := Text {
                text: "自动跟随";
                font-size: 13px;
                color: Theme.text-2;
                x: auto-switch.x - 8px - self.width;
                y: (parent.height - self.height) / 2;
            }

            startup-switch := Switch {
                checked <=> root.startup;
                toggled(on) => { root.toggle-startup(on); }
                x: auto-label.x - 24px - self.width;
                y: (parent.height - self.height) / 2;
            }
            startup-label := Text {
                text: "开机启动";
                font-size: 13px;
                color: Theme.text-2;
                x: startup-switch.x - 8px - self.width;
                y: (parent.height - self.height) / 2;
            }
        }

        // ================= 绑定卡片 =================
        Rectangle {
            vertical-stretch: 1;
            background: Theme.card;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    Text {
                        text: "屏幕 → 音频设备";
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    // 按型号名自动配对：HDMI/DP 音频的端点名里通常就含显示器型号
                    //（如「H24T7 (NVIDIA High Definition Audio)」），点一下就能把
                    // 还没绑定的屏配到自己的音箱上，省去逐个选下拉框。
                    AppButton {
                        text: "一键匹配";
                        clicked => { root.auto-match(); }
                    }
                    Text {
                        text: root.rules.length + " 条绑定";
                        font-size: 12px;
                        color: Theme.text-3;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Dropdown {
                        model: root.monitor-lines;
                        current-index <=> root.monitor-index;
                        placeholder: "选择屏幕";
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "→";
                        color: Theme.text-3;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Dropdown {
                        model: root.endpoint-lines;
                        current-index <=> root.endpoint-index;
                        placeholder: "选择音频设备";
                        horizontal-stretch: 1.5;
                    }
                    AppButton {
                        text: "添加绑定";
                        primary: true;
                        clicked => { root.add-rule(); }
                    }
                }

                // 添加失败的内联提示：原因就地显示。只沉到下面日志区的话，
                // 用户的注意力在按钮上，看不见。
                if root.add-hint != "" : Text {
                    text: root.add-hint;
                    font-size: 12px;
                    color: Theme.danger;
                }

                // 列表(空时显示引导文案)
                Rectangle {
                    vertical-stretch: 1;

                    if root.rules.length == 0 : VerticalLayout {
                        alignment: center;
                        spacing: 6px;

                        Text {
                            text: "还没有绑定";
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.text-2;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "点「一键匹配」按型号名自动配对；或从上方选一块屏幕和一台音频设备。\n之后窗口拖到那块屏，它的声音就会切到对应设备。";
                            font-size: 12px;
                            color: Theme.text-3;
                            horizontal-alignment: center;
                        }
                    }

                    if root.rules.length > 0 : ListView {
                        for r[index] in root.rules : row := Rectangle {
                            // 删除的两段式确认：第一次点 ✕ 只是点亮确认态（红色实底），
                            // 3 秒内再点才真删。绑定现在承载着"设备回来自动恢复"的
                            // 记忆价值，误删的代价比以前高。模型重推（规则变化）会
                            // 重建行，确认态随之复位——安全方向的失效，可接受。
                            property <bool> armed: false;
                            height: 46px;
                            border-radius: 7px;
                            background: row-hover.has-hover ? Theme.hover-row : transparent;
                            animate background { duration: 100ms; }

                            // 确认态 3 秒超时：点了 ✕ 却没有下文，自动熄灭
                            Timer {
                                interval: 3s;
                                running: row.armed;
                                triggered => { row.armed = false; }
                            }

                            row-hover := TouchArea { mouse-cursor: default; }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 10px;

                                // 左侧标识条:启用的蓝,停用的灰
                                Rectangle {
                                    width: 4px;
                                    Rectangle {
                                        y: 12px;
                                        width: parent.width;
                                        height: parent.height - 24px;
                                        border-radius: 2px;
                                        background: r.enabled ? Theme.accent : #c9d2df;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 1px;
                                    horizontal-stretch: 1.1;
                                    // 让两行文字在 46px 行高里垂直居中
                                    Rectangle { vertical-stretch: 1; }
                                    Text {
                                        text: r.monitor;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: r.enabled ? Theme.text : Theme.text-3;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: r.endpoint;
                                        font-size: 12px;
                                        color: r.enabled ? Theme.text-2 : Theme.text-3;
                                        overflow: elide;
                                    }
                                    Rectangle { vertical-stretch: 1; }
                                }

                                if row.armed : Text {
                                    text: "再点一次删除";
                                    font-size: 11px;
                                    color: Theme.danger;
                                    vertical-alignment: center;
                                }

                                // 行内停用开关：不删绑定，只是让这块屏暂时不参与
                                // 改道（那块屏上的应用恢复原路由）
                                Switch {
                                    checked: r.enabled;
                                    toggled(on) => { root.toggle-rule(index); }
                                }

                                // 行内删除:hover 变红底,armed 变红底白叉。
                                // "✕" 字符缺字形(渲染成豆腐块),用 Path 画两条线。
                                Rectangle {
                                    width: 28px;
                                    del-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (row.armed) {
                                                root.remove-rule(index);
                                            } else {
                                                row.armed = true;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 6px;
                                        background: row.armed ? Theme.danger
                                            : del-ta.has-hover ? Theme.danger-soft : transparent;
                                        animate background { duration: 100ms; }
                                        Path {
                                            width: 10px;
                                            height: 10px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            viewbox-width: 10;
                                            viewbox-height: 10;
                                            commands: "M 1.5 1.5 L 8.5 8.5 M 8.5 1.5 L 1.5 8.5";
                                            stroke: row.armed ? white
                                                : del-ta.has-hover ? Theme.danger : Theme.text-3;
                                            stroke-width: 1.4px;
                                            stroke-line-cap: round;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ================= 日志卡片(深色终端风) =================
        Rectangle {
            // 展开时与绑定卡片对半分剩余空间，收起时固定 170px。
            // 不用 `root.height * 0.5` 这类写法：窗口高度经由布局信息参与约束，
            // 引用它会形成绑定环（slint 明确警告可能运行时 panic）。
            // 改用「始终参与 stretch + 收起时用 max-height 封顶」表达两种状态。
            vertical-stretch: 1;
            min-height: 170px;
            max-height: root.log-expanded ? 4096px : 170px;
            background: Theme.log-bg;
            border-radius: 10px;
            clip: true;

            VerticalLayout {
                padding: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        // 钩子状态点:绿 = 事件钩子在跑
                        text: "●";
                        font-size: 10px;
                        color: root.hook-live ? Theme.ok : #5b6c86;
                        vertical-alignment: center;
                        width: 14px;
                    }
                    Text {
                        text: "运行日志";
                        font-size: 12px;
                        font-weight: 700;
                        color: #8ca2c0;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    AppButton {
                        text: root.log-expanded ? "收起日志" : "展开日志";
                        clicked => { root.log-expanded = !root.log-expanded; }
                    }
                }

                ListView {
                    // 钉底用 changed 回调而不是声明式绑定：用户滚轮一滚，
                    // slint 会写入 content-y 并**断开**声明式绑定（in-out 属性
                    // 被外部赋值后绑定失效），之后新日志看起来就"不刷新"了。
                    // changed 回调在每次 content-height 变化时强制拉回底部。
                    changed content-height => {
                        self.content-y = min(0, self.height - self.content-height);
                    }
                    for e in root.log-entries : HorizontalLayout {
                        height: 19px;
                        spacing: 8px;
                        Text {
                            text: e.time;
                            color: Theme.log-time;
                            font-size: 12px;
                            width: 64px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: e.msg;
                            color: Theme.log-text;
                            font-size: 12px;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }

        // ================= 底部操作栏 =================
        HorizontalLayout {
            spacing: 8px;

            // 左侧组合用固定宽度容器 + 绝对定位：避免和标题栏同样的对齐错位
            Rectangle {
                width: 268px;

                Text {
                    text: "实时事件驱动";
                    font-size: 13px;
                    color: Theme.text-2;
                    x: 0;
                    y: (parent.height - self.height) / 2;
                }
                Switch {
                    checked <=> root.event-driven;
                    toggled(on) => { root.toggle-event-driven(on); }
                    x: 84px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.event-driven
                        ? (root.hook-live ? "已启用 · 约 250ms 响应" : "钩子不可用,已退回轮询")
                        : "已关闭 · 纯轮询";
                    font-size: 11px;
                    color: Theme.text-3;
                    x: 128px;
                    width: parent.width - 128px;
                    overflow: elide;
                    y: (parent.height - self.height) / 2;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            AppButton {
                text: "重新扫描设备";
                clicked => { root.rescan(); }
            }
            AppButton {
                text: "立即应用";
                primary: true;
                clicked => { root.apply-now(); }
            }
            AppButton {
                text: "还原全部改动";
                danger: true;
                clicked => { root.restore-all(); }
            }
        }
    }
}
